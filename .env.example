# Copy to .env and adjust. Every setting from config/*.yaml can be overridden with
# KOMPAS__<SECTION>__<KEY>=value   (double underscore = nesting)

# Which overlay from config/environments/ to apply: dev | test | prod
KOMPAS_ENV=dev

# Security – ALWAYS override in production
KOMPAS__SECURITY__JWT_SECRET=change-me-to-a-long-random-string

# Pick an LLM profile from config/models/llm/*.yaml
# extractive (offline, default) | ollama | openai_compatible | gemini
KOMPAS__LLM__PROFILE=extractive

# API key read by OpenAI-compatible / Gemini profiles (name configurable in profile: api_key_env)
# LLM_API_KEY=
# GEMINI_API_KEY=

